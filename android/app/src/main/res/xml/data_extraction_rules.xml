<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Explicitly exclude database storage bearing credentials from cloud backups -->
        <exclude
            domain="database"
            path="kubenexus.db" />
        <exclude
            domain="database"
            path="kubenexus.db-shm" />
        <exclude
            domain="database"
            path="kubenexus.db-wal" />
        <exclude
            domain="database"
            path="kubenexus.db-journal" />
        <exclude
            domain="database"
            path="." />
        <!-- The kubeconfig keyset only works with its master key, which never leaves this device's Keystore -->
        <exclude
            domain="sharedpref"
            path="kubenexus_kubeconfig_keyset.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Explicitly exclude credential-bearing database storage from device transfers -->
        <exclude
            domain="database"
            path="kubenexus.db" />
        <exclude
            domain="database"
            path="kubenexus.db-shm" />
        <exclude
            domain="database"
            path="kubenexus.db-wal" />
        <exclude
            domain="database"
            path="kubenexus.db-journal" />
        <exclude
            domain="database"
            path="." />
        <!-- The kubeconfig keyset only works with its master key, which never leaves this device's Keystore -->
        <exclude
            domain="sharedpref"
            path="kubenexus_kubeconfig_keyset.xml" />
    </device-transfer>
</data-extraction-rules>